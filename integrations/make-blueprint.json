{
  "name": "PDVIE — Capture & RDV (Landing → Airtable + Gmail + Agenda)",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": 0,
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "restore": {
          "parameters": {
            "hook": {
              "label": "PDVIE Landing Webhook"
            }
          }
        },
        "parameters": [
          {
            "name": "hook",
            "type": "hook:gateway-webhook",
            "label": "Webhook",
            "required": true
          },
          {
            "name": "maxResults",
            "type": "number",
            "label": "Maximum number of results"
          }
        ]
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicRouter",
      "version": 1,
      "mapper": null,
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 3,
              "module": "airtable:makeApiCall",
              "version": 3,
              "parameters": {
                "__IMTCONN__": 6112403
              },
              "filter": {
                "name": "Nouveau lead",
                "conditions": [
                  [
                    {
                      "a": "{{1.type}}",
                      "b": "lead",
                      "o": "text:equal"
                    }
                  ]
                ]
              },
              "mapper": {
                "url": "v0/appRLYZbJgmORxkxz/tblqFCCV7BAO8IJNL",
                "method": "PATCH",
                "headers": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "qs": [],
                "body": "{\"performUpsert\":{\"fieldsToMergeOn\":[\"Email\"]},\"typecast\":true,\"records\":[{\"fields\":{\"Prénom\":\"{{1.firstname}}\",\"Email\":\"{{1.email}}\",\"WhatsApp\":\"{{1.whatsapp}}\",\"Persona\":\"{{1.personaLabel}}\",\"Langue\":\"{{upper(1.lang)}}\",\"Source\":\"{{1.source}}\",\"Étape tunnel\":\"Lead\",\"Statut\":\"Nouveau\",\"Date d'entrée\":\"{{formatDate(now; \"YYYY-MM-DD\")}}\"}}]}"
              },
              "metadata": {
                "designer": {
                  "x": 600,
                  "y": -150
                }
              }
            },
            {
              "id": 4,
              "module": "google-email:ActionSendEmail",
              "version": 1,
              "parameters": {
                "account": 6300394
              },
              "filter": {
                "name": "J0 — nouveau lead uniquement",
                "conditions": [
                  [
                    {
                      "a": "{{length(3.body.createdRecords)}}",
                      "b": "0",
                      "o": "number:greater"
                    }
                  ]
                ]
              },
              "mapper": {
                "to": [
                  "{{1.email}}"
                ],
                "subject": "{{switch(upper(1.lang); \"EN\"; \"🤍 Welcome \" + 1.firstname + \" — you've just taken your first step\"; \"🤍 Bienvenue \" + 1.firstname + \" — ton premier pas est fait\")}}",
                "html": "<p>{{switch(upper(1.lang); \"EN\"; \"Hello\"; \"Bonjour\")}} {{1.firstname}},</p><p>{{switch(upper(1.lang); \"EN\"; \"I wanted to tell you something simple: well done. You just took a step many people never dare to take. And you are no longer alone.\"; \"Je voulais te dire une chose simple : bravo. Tu as fait un pas que beaucoup n'osent pas faire. Et tu n'es plus seul(e).\")}}</p><p style=\"font-style:italic;color:#0f4d43\">{{switch(upper(1.lang); \"EN\"; \"“Behold, I stand at the door and knock. If anyone hears my voice and opens the door, I will come in to him.” — Revelation 3:20\"; \"« Voici, je me tiens à la porte, et je frappe. Si quelqu'un entend ma voix et ouvre la porte, j'entrerai chez lui. » — Apocalypse 3:20\")}}</p><div style=\"margin:22px 0;padding:16px 18px;border-left:3px solid #c9a23a;background:#faf6ef;border-radius:8px\"><div style=\"font-size:12px;letter-spacing:.05em;text-transform:uppercase;color:#a07c2e;font-weight:700\">{{switch(upper(1.lang); \"EN\"; \"🎥 Picked for you\"; \"🎥 Choisi pour toi\")}}</div><div style=\"font-weight:700;margin:5px 0 9px;color:#0f4d43\">{{switch(upper(1.lang); \"EN\"; switch(1.personaLabel; \"Ouvert\"; \"Nick Vujicic — a life that could have despaired\"; \"Blessé\"; \"“I fell into homosexuality…” — identity restored in Christ\"; \"Chercheur\"; \"Delivered from the New Age\"; \"Musulman\"; \"From Islam to Jesus (Al-Azzaz)\"; \"Sceptique\"; \"From atheist to meeting God\"; \"Stories of transformed lives\"); switch(1.personaLabel; \"Ouvert\"; \"Nick Vujicic — une vie qui aurait pu désespérer\"; \"Blessé\"; \"« J'ai chuté dans l'homosexualité… » — l'identité retrouvée en Christ\"; \"Chercheur\"; \"Délivré(e) du New Age\"; \"Musulman\"; \"De l'islam à Jésus (Al-Azzaz)\"; \"Sceptique\"; \"D'athée à la rencontre de Dieu\"; \"Des histoires de vies transformées\"))}}</div><a href=\"{{switch(1.personaLabel; \"Ouvert\"; \"https://youtu.be/UjpCD926y20\"; \"Blessé\"; \"https://youtu.be/98I2FSwcAho\"; \"Chercheur\"; \"https://youtu.be/wIk15HWS_5s\"; \"Musulman\"; \"https://youtu.be/HEOvRaTNZkU\"; \"Sceptique\"; \"https://youtu.be/gjC5_R9KeDo\"; \"https://nouvellesviesenjesus.fr/index.html#testimonials\")}}\" style=\"color:#1a6e60;font-weight:700\">{{switch(upper(1.lang); \"EN\"; \"▶ Watch the testimony\"; \"▶ Voir le témoignage\")}}</a></div><p>{{switch(upper(1.lang); \"EN\"; \"If you'd like to talk right now, just reply to this email or write on \"; \"Si tu veux échanger dès maintenant, réponds à cet email ou écris sur \")}}<a href=\"https://wa.me/33758372268\">WhatsApp</a>.</p><p style=\"font-size:13px;color:#5b6478\"><a href=\"https://nouvellesviesenjesus.fr/prier.html\" style=\"color:#5b6478\">{{switch(upper(1.lang); \"EN\"; \"When you're ready: pray now →\"; \"Quand tu seras prêt(e) : prier maintenant →\")}}</a></p><p>{{switch(upper(1.lang); \"EN\"; \"With all my affection in Christ,\"; \"Avec toute mon affection en Christ,\")}}<br>Nathanaël — Nouvelles Vies en Jésus</p>"
              },
              "metadata": {
                "designer": {
                  "x": 900,
                  "y": -150
                }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 5,
              "module": "airtable:makeApiCall",
              "version": 3,
              "parameters": {
                "__IMTCONN__": 6112403
              },
              "filter": {
                "name": "Réservation RDV",
                "conditions": [
                  [
                    {
                      "a": "{{1.type}}",
                      "b": "booking",
                      "o": "text:equal"
                    }
                  ]
                ]
              },
              "mapper": {
                "url": "v0/appRLYZbJgmORxkxz/tblqFCCV7BAO8IJNL",
                "method": "PATCH",
                "headers": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "qs": [],
                "body": "{\"performUpsert\":{\"fieldsToMergeOn\":[\"Email\"]},\"typecast\":true,\"records\":[{\"fields\":{\"Prénom\":\"{{1.firstname}}\",\"Email\":\"{{1.email}}\",\"WhatsApp\":\"{{1.whatsapp}}\",\"Langue\":\"{{upper(1.lang)}}\",\"Source\":\"{{1.source}}\",\"Étape tunnel\":\"RDV pris\",\"RDV prière\":\"{{1.rdvStartISO}}\"}}]}"
              },
              "metadata": {
                "designer": {
                  "x": 600,
                  "y": 150
                }
              }
            },
            {
              "id": 6,
              "module": "google-calendar:createAnEvent",
              "version": 5,
              "parameters": {
                "__IMTCONN__": 6109732
              },
              "mapper": {
                "select": "detail",
                "calendar": "nathanaelfongang@gmail.com",
                "summary": "🙏 RDV de prière — {{1.firstname}}",
                "conferenceDate": false,
                "allDayEvent": false,
                "start": "{{1.rdvStartISO}}",
                "end": "{{1.rdvEndISO}}",
                "attendees": [
                  {
                    "email": "{{1.email}}",
                    "displayName": "{{1.firstname}}"
                  }
                ],
                "description": "RDV de prière réservé depuis le site (Nouvelles Vies en Jésus / PDVIE).\nWhatsApp : {{1.whatsapp}}",
                "colorId": "10",
                "useDefault": true,
                "transparency": "opaque",
                "visibility": "default",
                "sendUpdates": "all"
              },
              "metadata": {
                "designer": {
                  "x": 900,
                  "y": 150
                }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 7,
              "module": "airtable:makeApiCall",
              "version": 3,
              "parameters": {
                "__IMTCONN__": 6112403
              },
              "filter": {
                "name": "Converti (a prié)",
                "conditions": [
                  [
                    {
                      "a": "{{1.type}}",
                      "b": "convert",
                      "o": "text:equal"
                    }
                  ]
                ]
              },
              "mapper": {
                "url": "v0/appRLYZbJgmORxkxz/tblqFCCV7BAO8IJNL",
                "method": "PATCH",
                "headers": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "qs": [],
                "body": "{\"performUpsert\":{\"fieldsToMergeOn\":[\"Email\"]},\"typecast\":true,\"records\":[{\"fields\":{\"Prénom\":\"{{1.firstname}}\",\"Email\":\"{{1.email}}\",\"Étape tunnel\":\"Prière faite\"}}]}"
              },
              "metadata": {
                "designer": {
                  "x": 600,
                  "y": 360
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "eu1.make.com"
  }
}
